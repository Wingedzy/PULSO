FROM node:18-alpine AS builder

WORKDIR /app

# Copiar package.json e instalar dependências de desenvolvimento primeiro
COPY package*.json ./
RUN npm ci

# Copiar código do servidor
COPY server/ ./server/

# Instalar dependências de produção apenas para o runtime
RUN npm ci --only=production --omit=dev

EXPOSE 3001

CMD ["node", "server/index.js"]